{
  "expo": {
    "name": "Oslo",
    "slug": "oslo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Oslo se conecta a la caja en la red local para enviar los productos escaneados.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.oslo.reader"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Oslo necesita la cámara para leer códigos de barras y vincularse con la caja.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
